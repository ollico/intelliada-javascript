{
    "compilerOptions": {
        "target": "ES2020",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "strict": true,
        "rootDir": "src",
        "declaration": true,
        "emitDeclarationOnly": true,
        "declarationDir": "types",
        "lib": ["ES2020", "DOM"],
        "skipLibCheck": true
    },
    "include": ["src"]
}
